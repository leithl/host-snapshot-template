#!/bin/sh
# /etc/etckeeper/pre-commit.d/50-system-snapshot
#
# TEMPLATE — install this file at /etc/etckeeper/pre-commit.d/50-system-snapshot,
# chmod +x. Runs before each etckeeper commit and dumps system state into
# /etc/system-snapshot/ so etckeeper picks it up on the same commit.
#
# CUSTOMIZATION:
#   - Edit the USERS list to match local accounts whose crontabs you want backed up.
#   - Comment out items you don't want (e.g. snap-list on a server with no snaps).

set -u
SNAP=/etc/system-snapshot
mkdir -p "$SNAP/usr-local-bin"
chmod 700 "$SNAP"

# Crontabs — edit USERS to match your accounts.
USERS="root <youruser>"
for user in $USERS; do
  # Skip unsubstituted template placeholder so a missed customization step
  # is explicit in the code, not silently swallowed by the [ -f ] guard.
  case "$user" in "<youruser>") continue ;; esac
  src="/var/spool/cron/crontabs/$user"
  if [ -f "$src" ]; then
    cp "$src" "$SNAP/${user}-crontab"
  fi
done

# Package manifests + system metadata
apt-mark showmanual > "$SNAP/apt-manual.txt" 2>/dev/null || true
snap list > "$SNAP/snap-list.txt" 2>/dev/null || true
{ uname -a; echo; cat /proc/cmdline; } > "$SNAP/kernel.txt" 2>/dev/null
{ lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,FSTYPE; echo; cat /proc/mdstat 2>/dev/null; } > "$SNAP/disks.txt"

# Firewall state: read-back of running iptables/ip6tables (incl. UFW chains,
# wg-quick PostUp adds, netfilter-persistent, anything ad-hoc). Not a deploy
# artifact — UFW config and any /etc/iptables/rules.v4 are restored via /etc
# directly; this is the diffable record of what actually ended up loaded.
command -v iptables-save  >/dev/null 2>&1 && iptables-save  > "$SNAP/iptables.rules.v4" 2>/dev/null || true
command -v ip6tables-save >/dev/null 2>&1 && ip6tables-save > "$SNAP/iptables.rules.v6" 2>/dev/null || true

# Custom scripts in /usr/local/bin (skip if your host has nothing custom there)
rsync -a --delete /usr/local/bin/ "$SNAP/usr-local-bin/" 2>/dev/null || true

# Re-stage system-snapshot/ so updates land in THIS commit, not the next one.
# Etckeeper's commit.d/30git-add runs before commit.d/50vcs-commit, and this
# pre-commit.d/ script only fires from git's pre-commit hook (which runs from
# inside that git commit, after the initial `git add --all`). Without this
# explicit re-stage, files newly created or modified here would be left as
# untracked/modified in the working tree and would have to wait for the *next*
# etckeeper commit to land in the repo.
git -C /etc add -A system-snapshot/ 2>/dev/null || true
