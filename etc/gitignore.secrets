# --- secret excludes for /etc (in place BEFORE first etckeeper commit) ---

# Linux account hashes — password & group hashes, including all known backup variants
shadow
shadow-
shadow.*
gshadow
gshadow-
gshadow.*
passwd-
passwd.*
group-
group.*
subuid-
subgid-

# PAM password history
security/opasswd

# SSH host private keys (publics stay tracked)
ssh/ssh_host_*_key

# Postfix relay credentials
postfix/sasl_passwd
postfix/sasl_passwd.db
postfix/saslpass*

# msmtp configs (catches msmtprc + all backup/variant suffixes)
msmtprc
msmtprc.*
.msmtprc
.msmtprc.*

# Let's Encrypt private bits (public certs stay tracked)
letsencrypt/archive/*/privkey*.pem
letsencrypt/keys
letsencrypt/accounts

# systemd encrypted credentials
credstore
credstore.encrypted

# WireGuard / OpenVPN private keys
wireguard
openvpn/*key*
openvpn/*.crt

# Defense-in-depth glob excludes — anything with private-key shape
*.key
*-key.pem
*privkey*
*sasl_passwd*
*.kdbx

# --- end secret excludes ---
# (etckeeper will append its own managed section below this on first init)
